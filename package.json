{
  "name": "@buddy-works/visual-tests-playwright",
  "version": "1.0.0",
  "description": "Buddy Visual Test Playwright Plugin",
  "keywords": [
    "playwright",
    "regression",
    "visual testing"
  ],
  "license": "MIT",
  "author": "Bartosz Wróbel",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/types/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "build": "node build.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^20.19.43",
    "esbuild": "0.28.2",
    "esbuild-node-externals": "2.0.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.30.0"
  },
  "engines": {
    "node": ">=20"
  }
}
